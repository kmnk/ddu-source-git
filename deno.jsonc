{
  "lock": false,
  "tasks": {
    "cache": "deno install --reload",
    "check": "deno check denops/**/*.ts",
    "lint": "deno lint denops",
    "lint-fix": "deno lint --fix denops",
    "fmt": "deno fmt denops",
    "test": "deno test -A --doc --parallel --shuffle denops/**/*.ts",
    "test:publish": "deno publish --dry-run --allow-dirty --set-version 0.0.0",
    "update": "deno outdated --recursive",
    "upgrade": "deno outdated --recursive --update"
  },
  "workspace": [
    "./denops/@ddu-git-utils",
    "./denops/@ddu-sources/git_branch",
    "./denops/@ddu-kinds/git_branch",
    "./denops/@ddu-sources/git_status",
    "./denops/@ddu-kinds/git_status",
    "./denops/@ddu-sources/git_log",
    "./denops/@ddu-kinds/git_log",
    "./denops/@ddu-sources/git_log_files",
    "./denops/@ddu-kinds/git_log_files",
    "./denops/@ddu-sources/git_stash",
    "./denops/@ddu-kinds/git_stash",
    "./denops/@ddu-sources/git_tag",
    "./denops/@ddu-kinds/git_tag",
    "./denops/@ddu-sources/git_reflog",
    "./denops/@ddu-kinds/git_reflog",
    "./denops/@ddu-sources/git_config",
    "./denops/@ddu-kinds/git_config",
    "./denops/@ddu-sources/git_remote",
    "./denops/@ddu-kinds/git_remote",
    "./denops/@ddu-sources/git_worktree",
    "./denops/@ddu-kinds/git_worktree",
    "./denops/@ddu-sources/git_grep",
    "./denops/@ddu-kinds/git_grep"
  ]
}
